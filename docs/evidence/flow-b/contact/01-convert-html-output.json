    "html": "<main>\n        <section class=\"rs cu\" id=\"contact-intro\">\n            <div class=\"fx\">\n                <h1 class=\"cu-h1\">Contact us</h1>\n                <div class=\"cu-panel\">\n                    <div class=\"cu-copy\">\n                        <h2 class=\"cu-h2\">We’re here for you before, during and after the sale</h2>\n                        <div class=\"cu-body\">\n                            <p class=\"cu-p\">At Mizuho America, we are committed to providing innovative tools designed to help neurosurgeons achieve the best outcomes. But our commitment extends even further. It includes unparalleled support every step of the way.</p>\n                            <p class=\"cu-p\">Want a product demo? Just ask. Have questions? We have answers. Got ideas? We’re listening.</p>\n                            <p class=\"cu-p\"><a class=\"cu-link\" href=\"#faq\"><strong>Get answers now to some of the most common questions</strong></a></p>\n                            <p class=\"cu-p\">Since opening our doors in 1993, we’ve become a trusted partner for countless neurosurgeons across the country.<br>We hope to become the same for you.</p>\n                        </div>\n                    </div>\n                    <aside class=\"cu-card\" aria-labelledby=\"cu-card-h\">\n                        <h2 class=\"cu-card-h\" id=\"cu-card-h\">Additional ways to contact us:</h2>\n                        <div class=\"cu-card-block cu-card-reach\">\n                            <p class=\"ln lh32\">Phone: <a class=\"cu-link\" href=\"tel:8006992547\">800-699-2547</a></p>\n                            <p class=\"ln lh32\">Fax: <a class=\"cu-link\" href=\"tel:5103244545\">510-324-4545</a></p>\n                            <p class=\"ln lh32\">Email: <a class=\"cu-link\" href=\"mailto:customerservice@mizuho.com\">customerservice@mizuho.com</a></p>\n                            <p class=\"ln lh32\"> <a class=\"cu-link\" href=\"tel:\"></a></p>\n                        </div>\n                        <div class=\"cu-card-block cu-card-hours\">\n                            <p class=\"ln lh20\"><span class=\"s16\">Hours: </span><span class=\"s16\">Monday-Friday:</span></p>\n                            <p class=\"ln lh26 sh3\"><span class=\"s16\">6:30 am–5:00 pm (PST)</span></p>\n                        </div>\n                        <div class=\"cu-card-block cu-card-addr\">\n                            <p class=\"ln lh30\"><span class=\"s16\">Address: </span><span class=\"s16\">30057 Ahem Avenue,</span></p>\n                            <p class=\"ln lh26 shn2\"><span class=\"s16\">Union City, CA 94587</span></p>\n                        </div>\n                    </aside>\n                </div>\n                <form class=\"cu-form\" id=\"contact-form\" action=\"#contact-form\" method=\"post\">\n                    <div class=\"cu-form-head\">\n                        <p class=\"cu-form-intro\">Ready to meet us? Just complete the fast form below.</p>\n                        <p class=\"cu-note\"><span class=\"req\">*</span> Indicates required field</p>\n                    </div>\n                    <div class=\"cu-fields\">\n                        <div class=\"fld\"><input class=\"fld-in\" id=\"cu-first-name\" name=\"first-name\" type=\"text\" placeholder=\" \" autocomplete=\"given-name\" required><label class=\"fld-label\" for=\"cu-first-name\">First Name<span class=\"req\" aria-hidden=\"true\">*</span></label></div>\n                        <div class=\"fld\"><input class=\"fld-in\" id=\"cu-last-name\" name=\"last-name\" type=\"text\" placeholder=\" \" autocomplete=\"family-name\" required><label class=\"fld-label\" for=\"cu-last-name\">Last Name<span class=\"req\" aria-hidden=\"true\">*</span></label></div>\n                        <div class=\"fld\"><input class=\"fld-in\" id=\"cu-institution\" name=\"institution\" type=\"text\" placeholder=\" \" autocomplete=\"organization\"><label class=\"fld-label\" for=\"cu-institution\">Institution</label></div>\n                        <div class=\"fld fld--select\"><label class=\"visually-hidden\" for=\"cu-state\">State</label><select class=\"fld-in\" id=\"cu-state\" name=\"state\">\n                                <option value=\"\" selected disabled>State</option>\n                            </select></div>\n                        <div class=\"fld\"><input class=\"fld-in\" id=\"cu-zip\" name=\"zip\" type=\"text\" placeholder=\" \" autocomplete=\"postal-code\"><label class=\"fld-label\" for=\"cu-zip\">ZIP</label></div>\n                        <div class=\"fld fld--select\"><label class=\"visually-hidden\" for=\"cu-country\">Country</label><select class=\"fld-in\" id=\"cu-country\" name=\"country\">\n                                <option value=\"\" selected disabled>Country</option>\n                            </select></div>\n                        <div class=\"fld\"><input class=\"fld-in\" id=\"cu-email\" name=\"email\" type=\"email\" placeholder=\" \" autocomplete=\"email\" required><label class=\"fld-label\" for=\"cu-email\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label></div>\n                        <div class=\"fld\"><input class=\"fld-in\" id=\"cu-phone\" name=\"phone\" type=\"tel\" placeholder=\" \" autocomplete=\"tel\" required><label class=\"fld-label\" for=\"cu-phone\">Phone<span class=\"req\" aria-hidden=\"true\">*</span></label></div>\n                        <div class=\"fld\"><input class=\"fld-in\" id=\"cu-area-of-interest\" name=\"area-of-interest\" type=\"text\" placeholder=\" \" autocomplete=\"off\"><label class=\"fld-label\" for=\"cu-area-of-interest\">Area of interest</label></div>\n                    </div>\n                    <fieldset class=\"cu-radio\">\n                        <legend class=\"cu-q\">Do you currently use any Mizuho America products?</legend><label class=\"cu-opt\"><input type=\"radio\" name=\"uses_products\" value=\"yes\">Yes</label><label class=\"cu-opt\"><input type=\"radio\" name=\"uses_products\" value=\"no\">No</label>\n                    </fieldset><button class=\"cu-submit\" type=\"submit\">Submit form</button>\n                </form>\n            </div>\n        </section>\n        <section class=\"rs faqs\" id=\"faq\">\n            <div class=\"fx\">\n                <h2 class=\"faq-h2\">While you’re here, get answers to Frequently Asked Questions:</h2>\n                <div class=\"faq-list\">\n                    <details class=\"faq\">\n                        <summary class=\"faq-q\">Are your products available internationally?<span class=\"faq-chev\" aria-hidden=\"true\"></span></summary>\n                    </details>\n                    <details class=\"faq\" open>\n                        <summary class=\"faq-q\">How do I obtain service or technical support?<span class=\"faq-chev\" aria-hidden=\"true\"></span></summary>\n                        <div class=\"faq-a\">\n                            <p>Contact our customer service or technical support team at <a class=\"cu-link\" href=\"mailto:customerservice@mizuho.com\">customerservice@mizuho.com</a> or call <a class=\"cu-link\" href=\"tel:8886992547\">888-699-2547</a> with the product name, model, and a description of the issue. We will help determine the appropriate next steps.</p>\n                        </div>\n                    </details>\n                    <details class=\"faq\">\n                        <summary class=\"faq-q\">Where can I find product documentation?<span class=\"faq-chev\" aria-hidden=\"true\"></span></summary>\n                    </details>\n                    <details class=\"faq\">\n                        <summary class=\"faq-q\">Is my clip MRI compatible?<span class=\"faq-chev\" aria-hidden=\"true\"></span></summary>\n                    </details>\n                    <details class=\"faq\">\n                        <summary class=\"faq-q\">How do I place an order or request a quote?<span class=\"faq-chev\" aria-hidden=\"true\"></span></summary>\n                    </details>\n                    <details class=\"faq\">\n                        <summary class=\"faq-q\">Can I try out instruments before buying?<span class=\"faq-chev\" aria-hidden=\"true\"></span></summary>\n                    </details>\n                    <details class=\"faq\">\n                        <summary class=\"faq-q\">Where are these instruments made?<span class=\"faq-chev\" aria-hidden=\"true\"></span></summary>\n                    </details>\n                    <details class=\"faq\">\n                        <summary class=\"faq-q\">What are these instruments used for?<span class=\"faq-chev\" aria-hidden=\"true\"></span></summary>\n                    </details>\n                    <details class=\"faq\">\n                        <summary class=\"faq-q\">Where is Mizuho America based?<span class=\"faq-chev\" aria-hidden=\"true\"></span></summary>\n                    </details>\n                </div><a class=\"faq-btn d-only\" href=\"#contact-form\">Complete our contact form</a>\n                <hr class=\"faq-rule\">\n            </div>\n        </section>\n        <section class=\"rs bl\" id=\"before-you-go\">\n            <div class=\"fx\">\n                <h2 class=\"bl-h2\">BEFORE YOU GO...</h2>\n                <div class=\"bl-btns\"><a class=\"bl-btn bl-btn--1\" href=\"#bottom-link-1\">Discover our wide range of products</a><a class=\"bl-btn bl-btn--2\" href=\"#bottom-link-2\">Access informative videos and brochures</a><a class=\"bl-btn bl-btn--3\" href=\"#bottom-link-3\">Learn why we’re a global leader in neurosurgical tools</a></div>\n            </div>\n        </section>\n    </main>",
